{
  "version": 1,
  "family": {
    "chief-of-staff": "on",
    "builder": "on",
    "qa": "on",
    "design": "on",
    "librarian": "on",
    "researcher": "on",
    "security": "optional",
    "tech-lead": "optional",
    "release-ops": "optional",
    "hotfix": "optional",
    "platform": "optional",
    "support": "optional",
    "project-lane": "off"
  },
  "helpers": {
    "max_per_session": 2,
    "model": "haiku"
  },
  "lanes": [
    {
      "id": "normal",
      "name": "Normal",
      "when": "default lane for any piece of work",
      "stages": [
        {
          "kind": "stage",
          "role": "librarian",
          "title": "Row + lessons",
          "produces": "Board row, lessons that apply"
        },
        {
          "kind": "stage",
          "role": "researcher",
          "title": "Research",
          "produces": "Note with file:line"
        },
        {
          "kind": "stage",
          "role": "design",
          "title": "Design",
          "produces": "Artifact: today vs proposed",
          "note": "skip if no screen changed"
        },
        {
          "kind": "word",
          "word": "approve",
          "title": "Owner's approval",
          "produces": "Words + date on the board"
        },
        {
          "kind": "stage",
          "role": "qa",
          "title": "Acceptance checks",
          "produces": "Written before code"
        },
        {
          "kind": "stage",
          "role": "builder",
          "title": "Build",
          "produces": "Own branch, proof per commit"
        },
        {
          "kind": "gate",
          "gate": "dev",
          "title": "Push to dev"
        },
        {
          "kind": "stage",
          "role": "release-ops",
          "title": "Dry run + batch",
          "produces": "Merge, gate, migrations"
        },
        {
          "kind": "word",
          "word": "release",
          "title": "\"release <scope>\"",
          "produces": "Typed or relayed in full"
        },
        {
          "kind": "gate",
          "gate": "live",
          "title": "Push live"
        },
        {
          "kind": "stage",
          "role": "chief-of-staff",
          "title": "Verify live",
          "produces": "Close row with sha"
        }
      ],
      "dev_signoffs": [
        "qa",
        "librarian",
        "chief-of-staff"
      ],
      "live_word": "release",
      "live_exempt_signoffs": false
    },
    {
      "id": "no-screen",
      "name": "No screen",
      "when": "no screen, template or style files change",
      "stages": [
        {
          "kind": "stage",
          "role": "librarian",
          "title": "Row + lessons",
          "produces": "Board row"
        },
        {
          "kind": "stage",
          "role": "researcher",
          "title": "Research",
          "produces": "Note with file:line"
        },
        {
          "kind": "stage",
          "role": "qa",
          "title": "Acceptance checks",
          "produces": "Written before code"
        },
        {
          "kind": "stage",
          "role": "builder",
          "title": "Build",
          "produces": "Own branch"
        },
        {
          "kind": "gate",
          "gate": "dev",
          "title": "Push to dev"
        },
        {
          "kind": "word",
          "word": "release",
          "title": "\"release <scope>\"",
          "produces": "Typed or relayed"
        },
        {
          "kind": "gate",
          "gate": "live",
          "title": "Push live"
        }
      ],
      "dev_signoffs": [
        "qa",
        "librarian",
        "chief-of-staff"
      ],
      "live_word": "release",
      "live_exempt_signoffs": false
    },
    {
      "id": "high",
      "name": "HIGH",
      "when": "risk HIGH: schema, auth, permissions, money, tenancy, deploy",
      "stages": [
        {
          "kind": "stage",
          "role": "researcher",
          "title": "Research",
          "produces": "Facts + volumes"
        },
        {
          "kind": "stage",
          "role": "security",
          "title": "Threat note",
          "produces": "docs/security/"
        },
        {
          "kind": "word",
          "word": "go",
          "title": "Owner's \"go\"",
          "produces": "Before any build"
        },
        {
          "kind": "stage",
          "role": "builder",
          "title": "Build",
          "produces": "Own branch"
        },
        {
          "kind": "stage",
          "role": "tech-lead",
          "title": "Independent review",
          "produces": "Architecture + schema"
        },
        {
          "kind": "gate",
          "gate": "dev",
          "title": "Push to dev"
        },
        {
          "kind": "word",
          "word": "release",
          "title": "\"release <scope>\"",
          "produces": "Typed or relayed"
        },
        {
          "kind": "gate",
          "gate": "live",
          "title": "Push live"
        }
      ],
      "dev_signoffs": [
        "qa",
        "tech-lead",
        "security",
        "librarian",
        "chief-of-staff"
      ],
      "live_word": "release",
      "live_exempt_signoffs": false,
      "require_word": "go"
    },
    {
      "id": "hotfix",
      "name": "Hotfix",
      "when": "live is broken",
      "stages": [
        {
          "kind": "stage",
          "role": "hotfix",
          "title": "Reproduce + fix",
          "produces": "Cloud session"
        },
        {
          "kind": "stage",
          "role": "qa",
          "title": "Short check",
          "produces": "Smoke only"
        },
        {
          "kind": "word",
          "word": "apply",
          "title": "\"apply\"",
          "produces": "Typed or relayed"
        },
        {
          "kind": "gate",
          "gate": "live",
          "title": "Push live"
        }
      ],
      "dev_signoffs": [],
      "live_word": "apply",
      "live_exempt_signoffs": true
    }
  ],
  "conditions": [
    {
      "id": "sensitive",
      "label": "Touches auth, payments, uploads or secrets",
      "globs": [
        "**/auth/**",
        "**/*auth*.*",
        "**/payment*/**",
        "**/billing/**",
        "**/upload*/**",
        ".env*",
        "**/permission*/**"
      ],
      "require": [
        "security"
      ]
    },
    {
      "id": "screens",
      "label": "Changes a screen",
      "globs": [
        "resources/views/**",
        "**/components/**",
        "**/pages/**",
        "**/*.css",
        "**/*.scss",
        "**/*.vue",
        "**/*.svelte",
        "**/*.tsx",
        "**/*.jsx",
        "templates/**"
      ],
      "require": [
        "design"
      ],
      "require_word": "approve"
    },
    {
      "id": "migrations",
      "label": "Adds a migration",
      "globs": [
        "**/migrations/**",
        "**/migrate/**",
        "db/**",
        "prisma/**"
      ],
      "require": [
        "tech-lead"
      ]
    }
  ],
  "words": {
    "approve": {
      "label": "Approval of an artifact or plan",
      "relay": true
    },
    "go": {
      "label": "Starts HIGH work",
      "relay": true
    },
    "release": {
      "label": "Moves a signed batch to live",
      "relay": true
    },
    "apply": {
      "label": "Moves a hotfix to live",
      "relay": true
    }
  },
  "roles": {},
  "blocked_sources": []
}
