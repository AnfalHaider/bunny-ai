{
  "$description": "Bunny AI design tokens v1.0 (2026-11-15). Mirrors :root in bunny-design-system.css. W3C design-tokens style.",
  "color": {
    "light": {
      "bg":          { "$value": "#faf9f6", "$description": "app canvas, thread" },
      "bg-sidebar":  { "$value": "#f3f1ec", "$description": "sidebar, user bubble, code wells" },
      "surface":     { "$value": "#ffffff", "$description": "composer, cards, menus, modals, inputs" },
      "hover":       { "$value": "#efece6" },
      "line":        { "$value": "#e6e2da", "$description": "hairlines and borders" },
      "line-strong": { "$value": "#d6d1c6" },
      "text":        { "$value": "#1f2023" },
      "text-dim":    { "$value": "#62666f", "$description": "secondary text, AA on bg" },
      "text-faint":  { "$value": "#8a8e96", "$description": "placeholders, key hints, disabled only" },
      "accent":      { "$value": "#6a4fd8", "$description": "violet: selection, focus, toggles, brand mark" },
      "accent-hover":{ "$value": "#5a3fc8" },
      "accent-soft": { "$value": "rgba(106,79,216,.08)" },
      "on-accent":   { "$value": "#ffffff" },
      "ink":         { "$value": "#1f2023", "$description": "send button, primary buttons" },
      "on-ink":      { "$value": "#faf9f6" },
      "ok":          { "$value": "#1f9d6a" },
      "warn":        { "$value": "#c07a12", "$description": "waiting on you, provider switched" },
      "bad":         { "$value": "#cf3f55" },
      "run":         { "$value": "#2f7fd6" }
    },
    "dark": {
      "bg":          { "$value": "#141518" },
      "bg-sidebar":  { "$value": "#1a1b1f" },
      "surface":     { "$value": "#1f2025" },
      "hover":       { "$value": "#26272d" },
      "line":        { "$value": "#2c2d33" },
      "line-strong": { "$value": "#3a3b42" },
      "text":        { "$value": "#ececee" },
      "text-dim":    { "$value": "#a0a2aa" },
      "text-faint":  { "$value": "#6e717a" },
      "accent":      { "$value": "#b3a1ff" },
      "accent-hover":{ "$value": "#c4b5ff" },
      "accent-soft": { "$value": "rgba(179,161,255,.10)" },
      "on-accent":   { "$value": "#15121f" },
      "ink":         { "$value": "#ececee" },
      "on-ink":      { "$value": "#141518" },
      "ok":          { "$value": "#53cf9b" },
      "warn":        { "$value": "#e9ad52" },
      "bad":         { "$value": "#f07a8c" },
      "run":         { "$value": "#6cb0ff" }
    },
    "terminal": {
      "bg": { "$value": "#16171b" }, "text": { "$value": "#d6d8de" }, "dim": { "$value": "#7b7f8a" },
      "ok": { "$value": "#53cf9b" }, "bad": { "$value": "#f07a8c" }
    }
  },
  "font": {
    "sans": { "$value": "Inter, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif" },
    "mono": { "$value": "'JetBrains Mono', ui-monospace, 'Cascadia Code', Consolas, monospace" },
    "size": {
      "2xs": { "$value": "11px" }, "xs": { "$value": "12px" }, "sm": { "$value": "12.5px" },
      "md": { "$value": "13px" }, "base": { "$value": "14px" }, "lg": { "$value": "16px" },
      "xl": { "$value": "22px" }, "2xl": { "$value": "28px" }
    },
    "weight": { "regular": { "$value": 400 }, "medium": { "$value": 500 }, "semibold": { "$value": 600 } },
    "lineHeight": { "tight": { "$value": 1.3 }, "base": { "$value": 1.55 }, "read": { "$value": 1.65 } }
  },
  "space": {
    "1": { "$value": "2px" }, "2": { "$value": "4px" }, "3": { "$value": "6px" }, "4": { "$value": "8px" },
    "5": { "$value": "10px" }, "6": { "$value": "12px" }, "7": { "$value": "14px" }, "8": { "$value": "16px" },
    "10": { "$value": "20px" }, "12": { "$value": "24px" }, "16": { "$value": "32px" }, "20": { "$value": "40px" }
  },
  "radius": {
    "xs": { "$value": "4px" }, "sm": { "$value": "6px" }, "md": { "$value": "8px" }, "lg": { "$value": "10px" },
    "xl": { "$value": "12px" }, "2xl": { "$value": "14px" }, "3xl": { "$value": "18px" }, "pill": { "$value": "999px" }
  },
  "shadow": {
    "sm":    { "$value": "0 1px 2px rgba(0,0,0,.05)" },
    "pop":   { "$value": "0 1px 2px rgba(0,0,0,.04), 0 8px 28px rgba(0,0,0,.08)" },
    "modal": { "$value": "0 24px 64px rgba(0,0,0,.18)" }
  },
  "layout": {
    "sidebar-w": { "$value": "248px" }, "pane-w": { "$value": "400px" }, "thread-max": { "$value": "720px" },
    "topbar-h": { "$value": "48px" }, "icon": { "$value": "18px" }, "icon-sm": { "$value": "16px" }, "hit": { "$value": "32px" }
  },
  "motion": {
    "ease": { "$value": "cubic-bezier(.2,.7,.2,1)" },
    "fast": { "$value": "120ms" }, "base": { "$value": "180ms" }, "slow": { "$value": "240ms" }
  }
}
