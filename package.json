{
  "name": "bunny-ai",
  "private": true,
  "version": "0.1.7",
  "type": "module",
  "description": "Provider-agnostic AI workspace: your own keys, your own machine.",
  "author": "Anfal Haider",
  "main": "electron/main.js",
  "scripts": {
    "start": "node src/server/main.js",
    "build:css": "node scripts/build-css.mjs",
    "test": "node --check src/providers/catalog.js && node --check src/providers/connections.js && node --check src/server/app.js && node scripts/unit-tests.mjs",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:e2e",
    "build:icons": "node scripts/build-icons.mjs",
    "desktop": "electron .",
    "dist": "node scripts/write-build-sha.mjs clear && npm run build:css && npm run build:icons && electron-builder --win nsis --x64 --publish never && node scripts/write-build-sha.mjs",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "playwright": "^1.65.0"
  },
  "build": {
    "appId": "ai.bunny.desktop",
    "productName": "Bunny AI",
    "copyright": "Copyright © 2026 Anfal Haider",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "src/**",
      "package.json",
      "build/icons/icon-256.png",
      "build/icons/icon-32.png"
    ],
    "publish": {
      "provider": "github",
      "owner": "AnfalHaider",
      "repo": "bunny-ai"
    },
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Bunny AI",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "Bunny-AI-Setup-${version}.${ext}"
    }
  },
  "dependencies": {
    "unpdf": "^2.2.0"
  }
}
