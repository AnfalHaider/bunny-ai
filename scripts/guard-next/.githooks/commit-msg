#!/bin/sh
# Owner's rule: Claude is never credited in Bunny AI commits, so GitHub never lists it as a
# contributor. GitHub adds a contributor from a Co-authored-by trailer, so any such trailer
# naming Claude or Anthropic is refused here, for every tool and every human.
msg_file="$1"
if grep -iqE '^co-authored-by:.*(claude|anthropic)|noreply@anthropic\.com|generated with \[?claude' "$msg_file"; then
  echo "commit-msg: this message credits Claude (Co-authored-by / noreply@anthropic.com / 'Generated with Claude')." >&2
  echo "The owner's rule: Claude is never credited in Bunny AI commits. Remove that line and commit again." >&2
  exit 1
fi
exit 0
