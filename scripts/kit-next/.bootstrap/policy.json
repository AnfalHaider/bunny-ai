{
  "version": 1,
  "branches": {
    "live": "main",
    "dev": "main"
  },
  "protected_globs": [
    ".bootstrap/**",
    ".claude/settings.json",
    ".githooks/**",
    "AGENTS.md",
    "CLAUDE.md",
    ".git/config",
    ".git/hooks/**",
    ".git/bootstrap-role",
    ".git/worktrees/*/bootstrap-role"
  ],
  "shell_parse": true,
  "shell_write_check": true,
  "scope_check": {
    "commit": true,
    "push": true,
    "push_exempt_roles": [
      "release-ops",
      "hotfix",
      "chief-of-staff"
    ]
  },
  "records_check": true,
  "records": {
    "globs": [
      "docs/signoffs/**",
      "docs/releases/**",
      "docs/flow-changes/**",
      "docs/kit-changes/**"
    ],
    "writers": [
      "chief-of-staff"
    ],
    "owner_patterns": {}
  },
  "destructive_commands": [
    "BUNNY_RESET_PROFILE\\s*=\\s*1",
    "Bunny-AI-Setup-[^\\s]*\\.exe\\s+(//|/)S\\b"
  ],
  "deny_all": [
    "\\bgit\\s+push\\b.*\\s(--force|-f|--force-with-lease)(\\s|=|$)",
    "\\bgit\\s+reset\\s+--hard\\b",
    "^\\s*(ssh|scp)\\s"
  ],
  "legacy_deny_all": [
    "--no-verify\\b",
    "\\bgit\\s+config\\b.*\\bcore\\.hooksPath\\b",
    "\\bgit\\b[^|;&]*\\scommit\\b[^|;&]*\\s-[A-Za-z]*n[A-Za-z]*(\\s|$)",
    "\\bgit\\b[^|;&]*\\s--no-ve(r(i(f(y)?)?)?)?(\\s|=|$)",
    "\\bgit\\b[^|;&]*\\s-c\\s*[Cc][Oo][Rr][Ee]\\.[Hh][Oo][Oo][Kk][Ss][Pp][Aa][Tt][Hh]",
    "\\bcore\\.hooksPath\\b"
  ],
  "releases": {
    "live_pushers": [
      "release-ops",
      "hotfix",
      "chief-of-staff"
    ]
  },
  "deny_all_whole": [
    "\\bGIT_CONFIG_(PARAMETERS|COUNT|KEY_\\d+|VALUE_\\d+)\\b"
  ]
}
